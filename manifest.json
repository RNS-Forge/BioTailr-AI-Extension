{
  "manifest_version": 3,
  "name": "BioTailr AI — Job Scanner & ATS Assistant",
  "version": "1.1.0",
  "description": "Scan any job listing. BioTailr AI generates a tailored 100% ATS resume in the web app and delivers it back for one-step download.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "BioTailr AI Job Scanner & Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "exclude_matches": ["https://rns-forge.github.io/BioTailr-AI/*"]
    },
    {
      "matches": ["https://rns-forge.github.io/BioTailr-AI/*"],
      "js": ["content-webapp.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
