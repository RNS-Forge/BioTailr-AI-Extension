{
  "manifest_version": 3,
  "name": "BioTailr AI - Job Scanner & ATS Assistant",
  "version": "1.2.0",
  "description": "Scan any job listing, generate 100% ATS tailored resumes, and high-speed Fast Auto Apply on LinkedIn, Indeed, Greenhouse, and Lever.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "BioTailr AI Job Scanner & Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "automation/form-solver.js",
        "platforms/base-platform.js",
        "platforms/linkedin/linkedin.js",
        "platforms/indeed/indeed.js",
        "platforms/greenhouse/greenhouse.js",
        "platforms/lever/lever.js",
        "automation/orchestrator.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://rns-forge.github.io/BioTailr-AI/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ]
    },
    {
      "matches": [
        "https://rns-forge.github.io/BioTailr-AI/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content-webapp.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
